# Copy to .env.local, fill in, then restart `npm run dev`.

# --- Cloudinary (required) — console.cloudinary.com → Settings → API Keys ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: unsigned uploads via a preset instead of key/secret (disables EXIF dates and URL import of own assets)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=impactlens

# --- AI vision (at least one required) — free tiers only by default ---
# Groq (console.groq.com/keys): main provider, free vision models picked automatically
GROQ_API_KEY=
# Optional model override, e.g. meta-llama/llama-4-scout-17b-16e-instruct
GROQ_MODEL=
# OpenRouter (openrouter.ai/keys): free models, used when Groq is unavailable
OPENROUTER_API_KEY=
# Optional comma-separated free-model preference, e.g. google/gemma-4-31b-it:free (non-free IDs are ignored)
OPENROUTER_MODEL=

# Optional: other providers, only used when listed in AI_PROVIDERS (e.g. AI_PROVIDERS=groq,openrouter,gemini)
AI_PROVIDERS=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database (optional) — SQLite file, created automatically ---
DATABASE_PATH=.data/impactlens.db
