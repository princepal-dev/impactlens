# Copy to .env.local, fill in, then restart `npm run dev`.

# --- Cloudinary (required) — console.cloudinary.com → Settings → API Keys ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: unsigned uploads via a preset instead of key/secret (disables EXIF dates and URL import of own assets)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=impactlens

# --- AI vision (at least one required) — free tiers only by default ---
# OpenRouter (openrouter.ai/keys): main provider, free models (Space Bunny Alpha, Gemma 4, Qwen 3.8, ...)
OPENROUTER_API_KEY=
# Optional free models to try before the built-in list, e.g. google/gemma-4-31b-it:free (paid IDs are ignored)
OPENROUTER_MODEL=
# Groq (console.groq.com/keys): used when OpenRouter is unavailable, free vision models picked automatically
GROQ_API_KEY=
# Optional model override, e.g. qwen/qwen3.8-27b
GROQ_MODEL=

# Optional provider order (default: openrouter,groq)
AI_PROVIDERS=

# --- Database (optional) — SQLite file, created automatically ---
DATABASE_PATH=.data/impactlens.db
