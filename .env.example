# ImpactLens runs fully without credentials (demo storage + deterministic AI).
# Copy to .env.local and fill in what you have. Restart `npm run dev` after changes.

# Force demo mode even when keys are present.
DEMO_MODE=false

# --- Cloudinary (media storage + transformations) ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Signed uploads + URL import (recommended):
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or unsigned uploads via a preset:
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=impactlens

# --- AI vision analysis (first one configured wins) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Optional persistence (see supabase/schema.sql) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
