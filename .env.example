# Copy to .env.local, fill in, then restart `npm run dev`.

# --- Cloudinary (required) — console.cloudinary.com → Settings → API Keys ---
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: unsigned uploads via a preset instead of key/secret (disables EXIF dates and URL import of own assets)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=impactlens

# --- AI vision (required) — aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Alternative provider, used only when GEMINI_API_KEY is empty
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Database (optional) — SQLite file, created automatically ---
DATABASE_PATH=.data/impactlens.db
