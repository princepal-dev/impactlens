generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id          String       @id
  slug        String       @unique
  name        String
  category    String
  location    String
  region      String
  description String       @default("")
  status      String       @default("Active")
  startDate   String       @map("start_date")
  createdAt   DateTime     @default(now()) @map("created_at")
  assets      MediaAsset[]
  reports     Report[]

  @@map("projects")
}

/// Searchable columns plus the full asset record as JSON.
model MediaAsset {
  id                 String   @id
  projectId          String?  @map("project_id")
  project            Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  cloudinaryPublicId String   @map("cloudinary_public_id")
  secureUrl          String   @map("secure_url")
  status             String
  captureDate        String?  @map("capture_date")
  createdAt          String   @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  data               Json

  @@index([projectId])
  @@index([status])
  @@index([captureDate, createdAt])
  @@map("media_assets")
}

model Report {
  id        String   @id
  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt String   @map("created_at")
  data      Json

  @@index([createdAt])
  @@map("reports")
}

model Activity {
  id      String   @id
  type    String
  message String
  href    String?
  at      DateTime @default(now())

  @@index([at])
  @@map("activity")
}
